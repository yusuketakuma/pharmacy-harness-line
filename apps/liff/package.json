{
  "name": "liff",
  "version": "0.34.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3002",
    "deploy": "pnpm build && wrangler pages deploy dist",
    "deploy:production": "pnpm build && wrangler pages deploy dist --project-name line-crm-liff-prod --branch main"
  },
  "dependencies": {
    "@line/liff": "^2.31.0",
    "hls.js": "^1.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
