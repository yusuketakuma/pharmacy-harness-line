{
  "name": "line-oss-crm",
  "version": "0.34.2",
  "private": true,
  "description": "Open-source LINE Official Account CRM/marketing automation",
  "scripts": {
    "dev:worker": "pnpm --filter worker dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "deploy:worker": "pnpm --filter worker deploy",
    "deploy:web": "pnpm --filter web build",
    "db:migrate": "wrangler d1 execute your-database --file=packages/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute your-database --file=packages/db/schema.sql --local",
    "deploy:setup": "node packages/create-line-harness/dist/index.js",
    "deploy:update": "node packages/create-line-harness/dist/index.js update",
    "sandbox:create-line-harness": "bash scripts/run-create-line-harness-sandbox.sh",
    "test:scripts": "vitest run --config vitest.config.mts",
    "verify:ci": "pnpm --filter @line-crm/shared --filter @line-crm/line-sdk --filter @line-crm/db --filter @line-harness/update-engine --filter @line-harness/sdk build && pnpm -r typecheck && pnpm -r test && pnpm test:scripts && pnpm tsx scripts/check-migrations.ts",
    "build:bundle": "tsx scripts/release/build-bundle.ts",
    "tenant:setup": "tsx scripts/custom/pharmacy/setup-tenant.ts",
    "tenant:settings": "tsx scripts/custom/pharmacy/manage-tenant-settings.ts",
    "tenant:admin-bootstrap": "tsx scripts/custom/pharmacy/bootstrap-tenant-admin.ts",
    "tenant:line-credentials": "tsx scripts/custom/pharmacy/migrate-line-credentials.ts",
    "rich-menu:catalog": "tsx scripts/custom/pharmacy/generate-rich-menu-catalog.ts",
    "platform:admin-bootstrap": "tsx scripts/custom/pharmacy/bootstrap-platform-admin.ts"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cyclonedx/cdxgen": "12.8.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0",
    "yaml": "^2.9.0"
  }
}
