{
  "name": "@line-harness/plugin-myservice",
  "version": "0.1.0",
  "private": true,
  "description": "LINE Harness plugin template — copy this directory to start a new integration",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc -p tsconfig.build.json",
    "build:mcp": "tsup mcp-server/index.ts --format esm --out-dir dist-mcp",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@line-harness/sdk": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.128.0",
    "zod": "^4.5.4"
  }
}
