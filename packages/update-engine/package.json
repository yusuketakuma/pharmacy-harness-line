{
  "name": "@line-harness/update-engine",
  "version": "0.0.11",
  "description": "Self-update engine for LINE Harness — shared between Worker (cloud-side self-update) and CLI (npx create-line-harness update)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shudesu/line-harness-oss.git",
    "directory": "packages/update-engine"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "import": "./dist/pure.mjs",
      "require": "./dist/pure.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && node scripts/preserve-node-builtins.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/tar-stream": "^3.1.4",
    "better-sqlite3": "^13.0.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "tar-stream": "^3.2.1"
  }
}
