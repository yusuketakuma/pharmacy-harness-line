    },
    {
      "id": "P2-V031-WEBHOOK-RETRY-BYTE-STABILITY",
      "status": "PASS",
      "summary": "Configured webhook retries now reuse the delivery row creation time so the same delivery ID also preserves request bytes and the HMAC signature."
    },
    {
      "id": "P1-V031-AD-PLATFORM-CREDENTIAL-PRESERVATION",
      "status": "PASS",
      "summary": "Ad platform updates now preserve omitted or masked stored credentials while still allowing explicit non-masked replacements."
    },
    {
      "id": "P1-V031-TENANT-WEBHOOK-AUTOMATION-SCOPE",
      "status": "PASS",
      "summary": "Tenant-only webhook events now execute only account-bound automations mapped to that tenant while keeping accountless, cross-tenant, and pharmacy generic automations blocked."
    },
    {
      "id": "P2-V031-GROUPED-USER-CACHE-BOUND",
