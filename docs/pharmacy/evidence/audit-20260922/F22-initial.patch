diff --git a/apps/worker/src/custom/pharmacy/continuity/dispatch-state.test.ts b/apps/worker/src/custom/pharmacy/continuity/dispatch-state.test.ts
new file mode 100644
index 0000000..f48ac3c
--- /dev/null
+++ b/apps/worker/src/custom/pharmacy/continuity/dispatch-state.test.ts
@@ -0,0 +1,178 @@
+import { readFileSync, readdirSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { join } from 'node:path';
+import { beforeEach, expect, it, vi } from 'vitest';
+import { d1FromSqlite, DB_PACKAGE_ROOT, openTestSqlite } from '../test-sqlite.js';
+
+const push = vi.hoisted(() => vi.fn().mockResolvedValue(undefined));
+const readCredential = vi.hoisted(() => vi.fn());
+vi.mock('../../../services/line-proxy-send.js', async original => ({...await original<typeof import('../../../services/line-proxy-send.js')>(), pushViaHarnessProxy: push}));
+vi.mock('../provisioning/line-credential-store.js', () => ({ readLineCredential: readCredential }));
+vi.mock('../beta-membership/repository.js', async (original) => ({
+  ...await original<typeof import('../beta-membership/repository.js')>(),
+  getPharmacyBetaNotificationBinding: vi.fn().mockResolvedValue(null),
+}));
+import { claimDueNextIntakeExpectations, endNextIntakeExpectation } from './next-intake.js';
+import { deliverContinuityReminder } from './notifications.js';
+import { pausePatientContinuity } from './repository.js';
+import { sendPharmacyAutomatedPush } from '../growth-loop/sender.js';
+
+const NOW = new Date('2026-09-22T00:00:00.000Z');
+const migration = '028_custom_080_pharmacy_continuity_notification_queue.sql';
+const { splitSqlStatements } = createRequire(import.meta.url)(
+  join(DB_PACKAGE_ROOT, 'scripts/split-sql-statements.mjs'),
+) as { splitSqlStatements: (sql: string) => string[] };
+
+function setup(legacy = false) {
+  const sqlite = openTestSqlite({ foreignKeys: true });
+  try {
+    if (legacy) {
+      for (const file of readdirSync(join(DB_PACKAGE_ROOT, 'migrations'))
+        .filter(name => name.endsWith('.sql') && name < migration).sort()) {
+        for (const statement of splitSqlStatements(readFileSync(join(DB_PACKAGE_ROOT, 'migrations', file), 'utf8'))) {
+          try {
+            sqlite.exec(statement);
+          } catch (error) {
+            // The bootstrap generator permits these historical idempotent additions.
+            if (!(error instanceof Error) || !/duplicate column name|already exists/i.test(error.message)) throw error;
+          }
+        }
+      }
+    } else {
+      sqlite.exec(readFileSync(join(DB_PACKAGE_ROOT, 'bootstrap.sql'), 'utf8'));
+    }
+ const now='2026-09-22T00:00:00.000Z';
+ for(const x of ['a','b']) {
+ sqlite.exec(`INSERT INTO tenants(id,tenant_code,display_name,outbound_messaging_paused_at) VALUES ('tenant-${x}','tenant-${x}','Synthetic',${x==='a'?"'2026-09-21T00:00:00.000Z'":'NULL'});
+ INSERT INTO line_accounts(id,channel_id,name,channel_access_token,channel_secret) VALUES ('account-${x}','channel-${x}','Synthetic','synthetic','synthetic');
+ INSERT INTO tenant_line_accounts(tenant_id,line_account_id) VALUES ('tenant-${x}','account-${x}');
+ UPDATE pharmacy_account_capabilities SET capabilities_json='["continuity"]' WHERE line_account_id='account-${x}';
+ INSERT INTO friends(id,line_user_id,provider_line_user_id,line_account_id,is_following) VALUES ('friend-${x}','user-${x}','provider-${x}','account-${x}',1);
+ INSERT INTO pharmacy_patients(id,line_account_id,owner_friend_id,relationship,name,name_kana,birth_date,created_at,updated_at) VALUES ('patient-${x}','account-${x}','friend-${x}','self','Synthetic','Synthetic','1990-01-01','${now}','${now}');
+ INSERT INTO pharmacy_patient_intake_responses(id,line_account_id,owner_friend_id,patient_id,revision,schema_version,patient_snapshot_json,answers_json,idempotency_key,representative_consent_at,privacy_consent_at,created_at) VALUES ('response-${x}','account-${x}','friend-${x}','patient-${x}',1,1,'{}','{}','synthetic-key','${now}','${now}','${now}');`);
+ }
+ for(let i=0;i<1;i++) {
+ const x=i<50?'a':'b'; const id=String(i).padStart(3,'0');
+ sqlite.exec(`INSERT INTO pharmacy_patients(id,line_account_id,owner_friend_id,relationship,name,name_kana,birth_date,created_at,updated_at) VALUES ('patient-${id}','account-${x}','friend-${x}','other','Synthetic','Synthetic','1990-01-01','${now}','${now}');
+ INSERT INTO pharmacy_patient_intake_responses(id,line_account_id,owner_friend_id,patient_id,revision,schema_version,patient_snapshot_json,answers_json,idempotency_key,representative_consent_at,privacy_consent_at,created_at) VALUES ('response-${id}','account-${x}','friend-${x}','patient-${id}',1,1,'{}','{}','synthetic-key-${id}','${now}','${now}','${now}');
+ INSERT INTO pharmacy_prescription_submissions(id,line_account_id,friend_id,idempotency_key,status,created_at,updated_at) VALUES ('sub-${id}','account-${x}','friend-${x}','synthetic-${id}','closed','${now}','${now}');
+ INSERT INTO pharmacy_prescription_patients(submission_id,line_account_id,owner_friend_id,patient_id,intake_response_id,created_at) VALUES ('sub-${id}','account-${x}','friend-${x}','patient-${id}','response-${id}','${now}');
+ INSERT INTO pharmacy_continuity_obligations(id,line_account_id,owner_friend_id,patient_id,source_submission_id,status,expected_next_from,expected_next_to,next_contact_at,consent_at,created_at,updated_at) VALUES ('obligation-${id}','account-${x}','friend-${x}','patient-${id}','sub-${id}','active','2026-09-21','2026-10-21','2026-09-21T00:00:00.000Z','${now}','${now}','${now}');
+ INSERT INTO pharmacy_next_intake_expectations(id,obligation_id,line_account_id,owner_friend_id,patient_id,status,timing_source,expected_from,expected_to,reminder_at,created_by,created_at,updated_at) VALUES ('expectation-${id}','obligation-${id}','account-${x}','friend-${x}','patient-${id}','active','manual_window','2026-09-21','2026-10-21','2026-09-21T00:00:00.000Z','synthetic-staff','${now}','${now}');`);
+ }
+
+    sqlite.exec("UPDATE tenants SET outbound_messaging_paused_at=NULL; UPDATE pharmacy_patients SET relationship='other' WHERE id='patient-a'; UPDATE pharmacy_patients SET relationship='self' WHERE id='patient-000'; UPDATE pharmacy_account_capabilities SET beta_enabled=0;");
+    return { sqlite, db: d1FromSqlite(sqlite) };
+  } catch (error) {
+    sqlite.close();
+    throw error;
+  }
+}
+
+beforeEach(() => {
+  push.mockReset().mockResolvedValue(undefined);
+  readCredential.mockReset().mockResolvedValue('synthetic-token');
+});
+
+function deliver(reminder: Parameters<typeof deliverContinuityReminder>[0], db: D1Database) {
+  return deliverContinuityReminder(reminder, {
+    db, proxyBaseUrl: 'https://synthetic.invalid', lineCredentialKey: 'synthetic',
+  });
+}
+
+async function end(db: D1Database, version = 1) {
+  return endNextIntakeExpectation(db, {
+    lineAccountId: 'account-a', expectationId: 'expectation-000',
+    expectedVersion: version, staffId: 'synthetic-staff',
+    idempotencyKey: 'synthetic-end-request', now: NOW,
+  });
+}
+
+it.each([false, true])('delivers an active expectation with the existing caller contract (legacy schema=%s)', async legacy => {
+  const { sqlite, db } = setup(legacy);
+  try {
+    const [reminder] = await claimDueNextIntakeExpectations(db, NOW, 1);
+    expect(await deliver(reminder, db)).toBe('sent');
+    expect(push).toHaveBeenCalledOnce();
+    expect(push.mock.calls[0][3]).toEqual([{type:'text',text:'次回のお薬の相談時期が近づいています。必要な処方せんがあれば、薬局へ事前送信できます。'}]);
+    expect(sqlite.prepare("SELECT status,version FROM pharmacy_next_intake_expectations WHERE id='expectation-000'").get())
+      .toEqual({status:'reminded',version:2});
+    expect(sqlite.prepare('PRAGMA foreign_key_check').all()).toEqual([]);
+    // The same legacy retry key reconciles confirmed delivery without another send.
+    expect(await deliver(reminder, db)).toBe('sent');
+    expect(push).toHaveBeenCalledOnce();
+  } finally { sqlite.close(); }
+});
+
+it.each(['before_delivery', 'at_final_read'])(
+  'does not send an expectation ended %s', async timing => {
+    const { sqlite, db } = setup();
+    try {
+      const [reminder] = await claimDueNextIntakeExpectations(db, NOW, 1);
+      const intercepted = {
+        ...db,
+        prepare: (sql: string) => {
+          const statement = db.prepare(sql);
+          if (!sql.includes('final pharmacy dispatch scope')) return statement;
+          return { bind: (...values: unknown[]) => ({ first: async () => {
+            await end(db);
+            return statement.bind(...values).first();
+          } }) };
+        },
+      } as D1Database;
+      if (timing === 'before_delivery') await end(db);
+      expect(await deliver(reminder, timing === 'at_final_read' ? intercepted : db)).toBe('skipped');
+      expect(push).not.toHaveBeenCalled();
+      expect(sqlite.prepare("SELECT status,version FROM pharmacy_next_intake_expectations WHERE id='expectation-000'").get())
+        .toEqual({status:'ended',version:2});
+    } finally { sqlite.close(); }
+  },
+);
+
+it('does not send after patient pause, and leaves the retry key usable after resumption', async () => {
+  const { sqlite, db } = setup();
+  try {
+    const [reminder] = await claimDueNextIntakeExpectations(db, NOW, 1);
+    await pausePatientContinuity(db, 'account-a', 'friend-a', 'obligation-000');
+    expect(await deliver(reminder, db)).toBe('skipped');
+    expect(push).not.toHaveBeenCalled();
+    expect(sqlite.prepare("SELECT outcome FROM pharmacy_notification_events WHERE idempotency_key='next-intake:expectation-000'").get()).toEqual({outcome:'attempted'});
+    // Simulate a later authorized resumption and the existing 15-minute retry window.
+    sqlite.exec("UPDATE pharmacy_continuity_obligations SET status='active' WHERE id='obligation-000'; UPDATE pharmacy_notification_events SET occurred_at=strftime('%Y-%m-%dT%H:%M:%fZ','now','-16 minutes') WHERE idempotency_key='next-intake:expectation-000'");
+    expect(await deliver(reminder, db)).toBe('sent');
+    expect(push).toHaveBeenCalledOnce();
+  } finally { sqlite.close(); }
+});
+
+it.each(['ended', 'linked', 'fulfilled'])(
+  'does not send after the parent obligation becomes %s', async status => {
+    const { sqlite, db } = setup();
+    try {
+      const [reminder] = await claimDueNextIntakeExpectations(db, NOW, 1);
+      sqlite.prepare('UPDATE pharmacy_continuity_obligations SET status=? WHERE id=?').run(status, 'obligation-000');
+      expect(await deliver(reminder, db)).toBe('skipped');
+      expect(push).not.toHaveBeenCalled();
+    } finally { sqlite.close(); }
+  },
+);
+
+it.each(['missing', 'foreign_account', 'wrong_patient', 'wrong_key'])(
+  'does not send with a %s domain reference', async mismatch => {
+    const { sqlite, db } = setup();
+    try {
+      const [reminder] = await claimDueNextIntakeExpectations(db, NOW, 1);
+      if (mismatch === 'wrong_patient') sqlite.exec("UPDATE pharmacy_patients SET relationship='other' WHERE id='patient-000'; UPDATE pharmacy_patients SET relationship='self' WHERE id='patient-a'");
+      const input = {
+        db, proxyBaseUrl:'https://synthetic.invalid', accessToken:'synthetic',
+        to: mismatch === 'foreign_account' ? 'provider-b' : reminder.line_user_id,
+        lineAccountId: mismatch === 'foreign_account' ? 'account-b' : reminder.line_account_id,
+        friendId: mismatch === 'foreign_account' ? 'friend-b' : reminder.owner_friend_id,
+        patientId: mismatch === 'foreign_account' ? 'patient-b' : mismatch === 'wrong_patient' ? 'patient-a' : reminder.patient_id,
+        messageId: 'continuity_reminder_v1' as const, category: 'continuity' as const,
+        retryKey: mismatch === 'missing' ? 'next-intake:missing' : mismatch === 'wrong_key' ? 'unknown:expectation-000' : 'next-intake:expectation-000',
+      };
+      expect(await sendPharmacyAutomatedPush(input)).toBe('patient_blocked');
+      expect(push).not.toHaveBeenCalled();
+    } finally { sqlite.close(); }
+  },
+);
